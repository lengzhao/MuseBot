# ============================================
# MuseBot 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入实际值
# ============================================
# 日志配置
# ============================================
# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# 基础配置
# ============================================
# 机器人名称
BOT_NAME=MuseBot

# LLM类型: deepseek, gemini, openai, openrouter, vol, chatanywhere
TYPE=

# 媒体类型: vol, gemini, openai, aliyun, 302-ai, openrouter
MEDIA_TYPE=

# 自定义URL
CUSTOM_URL=

# 自定义路径
CUSTOM_PATH=

# HTTP服务地址和端口
HTTP_HOST=:36060

# 语言设置: en, zh, ru
LANG=en

# 数据库类型: sqlite3, mysql, postgres
DB_TYPE=sqlite3

# 数据库配置
DB_CONF=

# 允许的用户ID列表（逗号分隔）
ALLOWED_USER_IDS=

# 允许的群组ID列表（逗号分隔）
ALLOWED_GROUP_IDS=

# LLM代理地址
LLM_PROXY=

# 机器人代理地址
ROBOT_PROXY=

# 每个用户的token限制
TOKEN_PER_USER=10000

# 每个用户最大并发聊天数
MAX_USER_CHAT=2

# 最大问答对数量
MAX_QA_PAIR=100

# AI角色设定
CHARACTER=

# 智能模式开关: true, false
SMART_MODE=true

# 上下文过期时间（秒）
CONTEXT_EXPIRE_TIME=86400

# Powered by 信息
POWERED=

# 是否发送MCP结果: true, false
SEND_MCP_RES=false

# 默认模型
DEFAULT_MODEL=

# LLM重试次数
LLM_RETRY_TIMES=3

# LLM可选参数: true, false
LLM_OPTION_PARAM=false

# 图片路径
IMAGE_PATH=./conf/img/

# 是否流式输出: true, false
IS_STREAMING=false

# 是否使用工具: true, false
USE_TOOLS=false

# SSL证书文件
CRT_FILE=
KEY_FILE=
CA_FILE=

# ============================================
# Telegram 配置
# ============================================
TELEGRAM_BOT_TOKEN=

# ============================================
# Discord 配置
# ============================================
DISCORD_BOT_TOKEN=

# ============================================
# Slack 配置
# ============================================
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ============================================
# Lark 配置
# ============================================
LARK_APP_ID=
LARK_APP_SECRET=

# ============================================
# 钉钉配置
# ============================================
DING_CLIENT_ID=
DING_CLIENT_SECRET=

# ============================================
# 微信配置
# ============================================
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ENCODING_AES_KEY=
WECHAT_ACTIVE=false

# ============================================
# 企业微信配置
# ============================================
COM_WECHAT_TOKEN=
COM_WECHAT_ENCODING_AES_KEY=
COM_WECHAT_CORP_ID=
COM_WECHAT_SECRET=
COM_WECHAT_AGENT_ID=

# ============================================
# QQ配置
# ============================================
QQ_APP_ID=
QQ_APP_SECRET=
QQ_ONEBOT_SEND_TOKEN=MuseBot
QQ_ONEBOT_RECEIVE_TOKEN=MuseBot
QQ_ONEBOT_HTTP_SERVER=http://127.0.0.1:3000

# ============================================
# ChatAnyWhere 配置
# ============================================
CHAT_ANY_WHERE_TOKEN=

# ============================================
# LLM Token 配置
# ============================================
# Deepseek Token
DEEPSEEK_TOKEN=

# OpenAI Token
OPENAI_TOKEN=

# Gemini Token
GEMINI_TOKEN=

# OpenRouter Token
OPEN_ROUTER_TOKEN=

# 302.ai Token
AI_302_TOKEN=

# 火山引擎 Token
VOL_TOKEN=

# 阿里云 Token
ALIYUN_TOKEN=

# 文心一言 AK/SK
ERNIE_AK=
ERNIE_SK=

# 火山引擎 AK/SK
VOLC_AK=
VOLC_SK=

# ============================================
# LLM 参数配置
# ============================================
# 频率惩罚
FREQUENCY_PENALTY=0.0

# 最大token数
MAX_TOKENS=2048

# 存在惩罚
PRESENCE_PENALTY=0.0

# 温度
TEMPERATURE=0.7

# Top P
TOP_P=0.9

# 停止序列（逗号分隔）
STOP=

# 是否记录概率
LOG_PROBS=false

# Top log probs数量
TOP_LOG_PROBS=0

# ============================================
# 音频配置
# ============================================
# TTS类型: vol, gemini, openai, aliyun
TTS_TYPE=

# 火山引擎音频配置
VOL_AUDIO_APP_ID=
VOL_AUDIO_TOKEN=
VOL_AUDIO_REC_CLUSTER=volcengine_input_common
VOL_AUDIO_VOICE_TYPE=
VOL_AUDIO_TTS_CLUSTER=volcano_tts
VOL_END_SMOOTH_WINDOW=1500
VOL_TTS_SPEAKER=zh_female_vv_jupiter_bigtts
VOL_BOT_NAME=豆包
VOL_SYSTEM_ROLE=你使用活泼灵动的女声，性格开朗，热爱生活。
VOL_SPEAKING_STYLE=你的说话风格简洁明了，语速适中，语调自然。

# Gemini音频配置
GEMINI_AUDIO_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE_NAME=Kore

# OpenAI音频配置
OPENAI_AUDIO_MODEL=tts-1
OPENAI_VOICE_NAME=alloy

# 阿里云音频配置
ALIYUN_AUDIO_MODEL=qwen3-tts-flash
ALIYUN_AUDIO_VOICE=Cherry
ALIYUN_AUDIO_REC_MODEL=qwen-audio-turbo-latest

# ============================================
# 图片配置
# ============================================
# 请求密钥
REQ_KEY=high_aes_general_v21_L

# 模型版本
MODEL_VERSION=general_v2.1_L

# 请求调度配置
REQ_SCHEDULE_CONF=general_v20_9B_pe

# 随机种子（-1表示随机）
SEED=-1

# 缩放因子
SCALE=3.5

# DDIM步数
DDIM_Steps=25

# 图片宽度
WIDTH=512

# 图片高度
HEIGHT=512

# 是否使用预LLM: true, false
USE_PER_LLM=true

# 是否使用超分辨率: true, false
USE_SR=true

# 是否返回URL: true, false
RETURN_URL=true

# 是否添加Logo: true, false
ADD_LOGO=false

# Logo位置
POSITION=

# 图片语言
PHOTO_LANGUAGE=1

# Logo透明度
OPACITY=0.3

# Logo文本内容
LOGO_TEXT_CONTENT=

# Gemini图片配置
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
GEMINI_REC_MODEL=gemini-2.0-flash

# OpenAI图片配置
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_REC_MODEL=chatgpt-4o-latest
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_STYLE=

# 火山引擎图片配置
VOL_IMAGE_MODEL=doubao-seed-1-6-250615
VOL_REC_MODEL=doubao-seed-1-6-250615

# Mix/AI302/OpenRouter图片配置
MIX_IMAGE_MODEL=gpt-image-1
MIX_REC_MODEL=chatgpt-4o-latest

# 阿里云图片配置
ALIYUN_IMAGE_MODEL=qwen-image-plus
ALIYUN_REC_MODEL=qwen-vl-max-latest

# ============================================
# 视频配置
# ============================================
# 火山引擎视频模型
VOL_VIDEO_MODEL=doubao-seedance-1-0-pro-250528

# 视频宽高比
RADIO=1:1

# 视频时长（秒，仅支持5或10）
DURATION=5

# 帧率
FPS=24

# 分辨率（仅支持480p或720p）
RESOLUTION=480p

# 是否包含水印: true, false
WATERMARK=false

# Gemini视频模型
GEMINI_VIDEO_MODEL=veo-2.0-generate-001

# 302.ai视频模型
302_AI_VIDEO_MODEL=luma_video

# ============================================
# RAG配置
# ============================================
# 嵌入类型: openai, gemini, ernie
EMBEDDING_TYPE=

# 知识库路径
KNOWLEDGE_PATH=

# 向量数据库类型: chroma, weaviate, milvus
VECTOR_DB_TYPE=milvus

# Chroma配置
CHROMA_URL=http://localhost:8000
SPACE=MuseBot

# Milvus配置
MILVUS_URL=http://localhost:19530

# Weaviate配置
WEAVIATE_URL=localhost:8000
WEAVIATE_SCHEME=http

# 分块大小
CHUNK_SIZE=500

# 分块重叠大小
CHUNK_OVERLAP=50

# ============================================
# 注册配置（服务发现）
# ============================================
# 注册类型: etcd
REGISTER_TYPE=

# Etcd配置（多个URL用逗号分隔）
ETCD_URLS=http://127.0.0.1:2379
ETCD_USERNAME=
ETCD_PASSWORD=

# ============================================
# 工具配置（MCP）
# ============================================
# MCP配置文件路径
MCP_CONF_PATH=

# ============================================
# 管理后台配置
# ============================================
# 数据库类型（管理后台）
# DB_TYPE=sqlite3

# 数据库配置（管理后台）
# DB_CONF=

# 会话密钥
SESSION_KEY=muse_bot_session_key

# 管理后台端口
ADMIN_PORT=18080

# 检查机器人间隔（秒）
CHECK_BOT_SEC=10

# ============================================
# CMD Agent 模式配置
# ============================================
# Agent 类型选择（qoder/opencode/cursor/custom）
CMD_AGENT_TYPE=qoder

# agent 命令超时时间（秒，默认 300）
CMD_AGENT_TIMEOUT=300
